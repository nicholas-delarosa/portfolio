# Copia este archivo como .env y llena los valores. NUNCA subas el .env a GitHub.

# Dominio público. En local déjalo en :80
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# Base de datos (usa una contraseña larga y aleatoria en producción)
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=cambia-esta-contraseña

# Usuario de GitHub que puede entrar al admin
ADMIN_GITHUB_LOGIN=nicholas-delarosa

# OAuth App de GitHub (github.com/settings/developers)
# Callback URL: https://TU-DOMINIO/api/auth/signin-github
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Token de GitHub de solo lectura para sincronizar los repos públicos
# (github.com/settings/personal-access-tokens -> Fine-grained -> "Public repositories (read-only)")
GITHUB_TOKEN=

# Cloudinary: panel -> API Keys -> "API environment variable" (cloudinary://KEY:SECRET@CLOUD)
CLOUDINARY_URL=
